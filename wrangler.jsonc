{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smartbooks-promoter-ai",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/auth/*", "/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "FB_TOKENS",
      "id": "7eefc947c1ae421d94a79ba473d8652f"
    }
  ]
}
